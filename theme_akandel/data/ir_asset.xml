<?xml version="1.0" encoding="utf-8"?>
<odoo>

<asset id="theme_akandel.primary_variables_scss" name="Akandel primary variables SCSS">
    <field name="key">theme_akandel.primary_variables_scss</field>
    <bundle>web._assets_primary_variables</bundle>
    <path>theme_akandel/static/src/scss/primary_variables.scss</path>
</asset>

<asset id="theme_akandel.bootstrap_overridden_scss" name="Akandel Bootstrap overridden SCSS">
    <field name="key">theme_akandel.bootstrap_overridden_scss</field>
    <bundle directive="prepend">web._assets_frontend_helpers</bundle>
    <path>theme_akandel/static/src/scss/bootstrap_overridden.scss</path>
</asset>

</odoo>
