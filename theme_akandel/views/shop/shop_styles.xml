<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Akandel shop page styles (generated by tools/gen_shop_cart.py). One active at a time,
     selected in Website Builder > Products Page > Shop Style. -->

<template id="ak_shop_style_clean" inherit_id="website_sale.products" name="Akandel Shop Style 01: Clean Cards" active="False">
    <xpath expr="//div[@id='o_wsale_container']" position="attributes">
        <attribute name="t-attf-class" add="ak-shop ak-shop-clean" separator=" "/>
    </xpath>
</template>

