<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Akandel add-to-cart experiences (generated by tools/gen_shop_cart.py). One active at a
     time, selected in Website Builder > Products Page / Product Page > Add to Cart Style. -->

<template id="ak_cart_style_drawer" inherit_id="website.layout" name="Akandel Cart Style 01: Side Drawer" active="False">
    <xpath expr="//div[@id='wrapwrap']" position="attributes">
        <attribute name="data-ak-cart-style">drawer</attribute>
        <attribute name="data-ak-cart-type">drawer-right</attribute>
        <attribute name="data-ak-cart-mode">full</attribute>
    </xpath>
</template>

