            <div id="o_main_nav" class="o_main_nav">
                <t t-call="theme_akandel.ak_header_main_row" _ak_nav_class.f="ak-nav-caps" _ak_row_class.f="py-1"/>
            </div>
        </t>
        <t t-call="website.template_header_mobile"/>
    </xpath>
</template>

<!-- 23. Two calls to action -->
<template id="template_header_ak_duo" inherit_id="website.layout" name="Akandel Header: Two Buttons" active="False">
    <xpath expr="//header//nav" position="replace">
        <t t-call="website.navbar" _navbar_classes.f="ak-header ak-header-duo d-none d-lg-block">
            <div id="o_main_nav" class="o_main_nav">
                <t t-call="theme_akandel.ak_header_main_row" _ak_ctas="True" _ak_nav_wrap_class.f="me-auto"/>
            </div>
        </t>
        <t t-call="website.template_header_mobile"/>
    </xpath>
</template>

<!-- 24. Slim -->
<template id="template_header_ak_slim" inherit_id="website.layout" name="Akandel Header: Slim" active="False">
    <xpath expr="//header//nav" position="replace">
        <t t-call="website.navbar" _navbar_classes.f="ak-header ak-header-slim d-none d-lg-block">
            <div id="o_main_nav" class="o_main_nav">
                <t t-call="theme_akandel.ak_header_main_row" _ak_row_class.f="py-0" _ak_nav_wrap_class.f="ms-auto me-3"/>
            </div>
        </t>
        <t t-call="website.template_header_mobile"/>
    </xpath>
</template>

</odoo>
