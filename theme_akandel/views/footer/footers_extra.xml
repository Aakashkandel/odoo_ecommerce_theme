<!-- 13. App download -->
<template id="template_footer_ak_app" inherit_id="website.layout" name="Akandel Footer: App Download" active="False">
    <xpath expr="//div[@id='footer']" position="replace">
        <div id="footer" class="oe_structure oe_structure_solo ak-footer ak-footer-app" t-ignore="true" t-if="not no_footer">
            <section class="s_text_block pt64 pb64" data-snippet="s_text_block" data-name="App Band">
                <div class="container">
                    <div class="ak-app-band row align-items-center g-4">
                        <div class="col-lg-7">
                            <p class="ak-eyebrow">Shop on the go</p>
                            <h3 class="mb-2">Get the app for faster checkout &amp; exclusive deals</h3>
                            <p class="mb-0 ak-muted">Track orders, save favourites and receive members-only offers.</p>
                        </div>
                        <div class="col-lg-5 d-flex gap-2 justify-content-lg-end">
                            <a href="#" aria-label="Download on the App Store"><img class="ak-store-badge" src="/website/static/src/img/snippets_demo/app_store.svg" alt="App Store" loading="lazy"/></a>
                            <a href="#" aria-label="Get it on Google Play"><img class="ak-store-badge" src="/website/static/src/img/snippets_demo/google_play.svg" alt="Google Play" loading="lazy"/></a>
                        </div>
                    </div>
                    <div class="row g-4 pt-5">
                        <div class="col-6 col-lg-3"><h6 class="ak-footer-title">Shop</h6><ul class="list-unstyled ak-footer-links"><li><a href="/shop">All products</a></li><li><a href="/shop">New arrivals</a></li><li><a href="/shop">Offers</a></li></ul></div>
                        <div class="col-6 col-lg-3"><h6 class="ak-footer-title">Help</h6><ul class="list-unstyled ak-footer-links"><li><a href="/contactus">Contact</a></li><li><a href="/my/orders">Orders</a></li><li><a href="#">Returns</a></li></ul></div>
                        <div class="col-6 col-lg-3"><h6 class="ak-footer-title">Company</h6><ul class="list-unstyled ak-footer-links"><li><a href="/aboutus">About us</a></li><li><a href="#">Careers</a></li><li><a href="#">Press</a></li></ul></div>
                        <div class="col-6 col-lg-3"><h6 class="ak-footer-title">Follow</h6><t t-call="theme_akandel.ak_footer_social"/></div>
                    </div>
                </div>
            </section>
        </div>
    </xpath>
</template>

