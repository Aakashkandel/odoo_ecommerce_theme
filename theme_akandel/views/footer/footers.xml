<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    Akandel footer variants.

    Same contract as the core `website.template_footer_*` views: they replace
    `div#footer` of `website.layout` with an editable `oe_structure_solo`
    made of regular building blocks (text, social media, newsletter...), so
    everything stays editable in the Website Builder. They are selected from
    Website Builder > Footer > Template.
-->

<!-- Shared, real newsletter form (website_mass_mailing). -->
<template id="ak_footer_newsletter_form" name="Akandel Footer Newsletter Form">
    <t t-set="ak_mailing_list" t-value="website.env.ref('mass_mailing.mailing_list_data', raise_if_not_found=False)"/>
    <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe ak-newsletter-form" data-vxml="001"
         t-att-data-list-id="ak_mailing_list.id if ak_mailing_list else 0" data-name="Newsletter Form">
        <div class="js_subscribed_wrap d-none">
            <p class="ak-newsletter-success mb-0"><i class="fa fa-check-circle-o me-1" role="img" aria-hidden="true"/>Thank you, you are on the list.</p>
        </div>
        <div class="js_subscribe_wrap">
            <div class="input-group">
                <input type="email" name="email" class="js_subscribe_value form-control" placeholder="Your email address" aria-label="Email address"/>
                <a role="button" href="#" t-attf-class="js_subscribe_btn o_submit btn #{_ak_btn_class or 'btn-primary'}">Subscribe</a>
            </div>
        </div>
    </div>
</template>

<!-- Shared social links (regular s_social_media block). -->
<template id="ak_footer_social" name="Akandel Footer Social">
    <div t-attf-class="s_social_media o_not_editable ak-social #{_ak_class or 'text-start'}" data-snippet="s_social_media" data-name="Social Media" contenteditable="false">
        <h5 class="s_social_media_title d-none" contenteditable="true">Follow us</h5>
        <a href="/website/social/instagram" class="s_social_media_instagram" target="_blank" aria-label="Instagram">
            <i class="fa fa-instagram rounded-circle o_editable_media"/>
        </a>
        <a href="/website/social/facebook" class="s_social_media_facebook" target="_blank" aria-label="Facebook">
            <i class="fa fa-facebook rounded-circle o_editable_media"/>
        </a>
        <a href="/website/social/twitter" class="s_social_media_twitter" target="_blank" aria-label="X">
            <i class="fa fa-twitter rounded-circle o_editable_media"/>
        </a>
        <a href="/website/social/youtube" class="s_social_media_youtube" target="_blank" aria-label="YouTube">
            <i class="fa fa-youtube-play rounded-circle o_editable_media"/>
        </a>
    </div>
</template>

<!-- 1. Columns: brand + three link columns + newsletter -->
