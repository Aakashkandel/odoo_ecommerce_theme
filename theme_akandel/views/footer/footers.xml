                <div class="container">
                    <div class="row g-5">
                        <div class="col-lg-4">
                            <p class="ak-footer-brand h3 mb-3">Akandel</p>
                            <p class="ak-footer-lead">Furniture and objects designed to be lived with — made by independent workshops, delivered with care.</p>
                            <t t-call="theme_akandel.ak_footer_social"/>
                        </div>
                        <div class="col-6 col-lg-2">
                            <h6 class="ak-footer-title">Shop</h6>
                            <ul class="list-unstyled ak-footer-links">
                                <li><a href="/shop">All products</a></li>
                                <li><a href="/shop">New arrivals</a></li>
                                <li><a href="/shop">Best sellers</a></li>
                                <li><a href="/shop">Gift cards</a></li>
                            </ul>
                        </div>
                        <div class="col-6 col-lg-2">
                            <h6 class="ak-footer-title">Help</h6>
                            <ul class="list-unstyled ak-footer-links">
                                <li><a href="/contactus">Contact us</a></li>
                                <li><a href="/my/orders">Track an order</a></li>
                                <li><a href="#">Delivery &amp; returns</a></li>
                                <li><a href="#">Care guide</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-4">
                            <h6 class="ak-footer-title">Join the Akandel letter</h6>
                            <p class="small ak-muted">New collections, workshop stories and early access to sales. No spam, ever.</p>
                            <t t-call="theme_akandel.ak_footer_newsletter_form"/>
                        </div>
