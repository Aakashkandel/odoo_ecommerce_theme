<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- Hero: split layout, copy left and framed image right -->
<template id="s_ak_hero_split" name="Akandel Split Hero">
    <section class="s_ak_hero_split o_cc o_cc2 pt80 pb80" data-snippet="s_ak_hero_split" data-name="Split Hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6 order-2 order-lg-1">
                    <p class="ak-eyebrow">New season · Living collection</p>
                    <h1 class="display-3 mb-4">Rooms that feel <em>like you</em>.</h1>
                    <p class="lead ak-lead mb-4">Honest materials, quiet shapes and pieces made to be lived with. Discover furniture and objects from independent workshops.</p>
                    <p class="d-flex flex-wrap gap-2 mb-5">
                        <a href="/shop" class="btn btn-primary btn-lg">Shop the collection</a>
                        <a href="/aboutus" class="btn btn-outline-secondary btn-lg">Our story</a>
                    </p>
                    <ul class="list-unstyled ak-hero-proof d-flex flex-wrap gap-4 mb-0">
                        <li><strong>4.9/5</strong><span>from 2,300+ reviews</span></li>
                        <li><strong>30 days</strong><span>free returns</span></li>
                        <li><strong>10 years</strong><span>frame guarantee</span></li>
                    </ul>
                </div>
                <div class="col-lg-6 order-1 order-lg-2">
                    <div class="ak-hero-media">
                        <img class="img-fluid ak-radius-xl w-100" src="/website/static/src/img/library/shop_generic_1_lg.jpg" alt="Grey sofa in a sunlit living room" loading="eager"/>
                        <div class="ak-hero-badge">
                            <span class="ak-hero-badge-label">Bestseller</span>
                            <span class="ak-hero-badge-title">The Loma sofa</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Hero: full-bleed image with centered message -->
<template id="s_ak_hero_cover" name="Akandel Cover Hero">
    <section class="s_ak_hero_cover oe_img_bg o_bg_img_center o_cc o_cc5 pt160 pb160" data-snippet="s_ak_hero_cover" data-name="Cover Hero"
             style="background-image: url('/website/static/src/img/library/shop_generic_2_lg.jpg');">
        <div class="o_we_bg_filter" style="background-image: linear-gradient(180deg, rgba(15, 16, 17, 0.15) 0%, rgba(15, 16, 17, 0.65) 100%);"/>
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <p class="ak-eyebrow">The velvet edit</p>
                    <h1 class="display-2 mb-4">Deep colour, soft comfort.</h1>
                    <p class="lead mb-5">Sofas, armchairs and cushions in rich, hard-wearing velvets.</p>
                    <p class="mb-0"><a href="/shop" class="btn btn-light btn-lg">Discover the edit</a></p>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Hero: editorial headline with a three-image collage -->
<template id="s_ak_hero_editorial" name="Akandel Editorial Hero">
    <section class="s_ak_hero_editorial o_cc o_cc1 pt64 pb80" data-snippet="s_ak_hero_editorial" data-name="Editorial Hero">
        <div class="container">
            <div class="row align-items-end g-4 mb-5">
                <div class="col-lg-7">
                    <h1 class="display-1 mb-0">Made slowly.<br/>Kept <em>forever</em>.</h1>
                </div>
                <div class="col-lg-4 offset-lg-1">
                    <p class="lead ak-lead mb-4">Our autumn collection celebrates oak, linen and hand-thrown ceramics — designed to age beautifully.</p>
                    <a href="/shop" class="btn btn-primary">Shop autumn</a>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-lg-6">
                    <img class="img-fluid ak-radius-lg w-100 ak-ratio-tall" src="/website/static/src/img/snippets_demo/s_images_mosaic_default_image_4.jpg" alt="Terracotta vases in an arched niche" loading="lazy"/>
                </div>
                <div class="col-6 col-lg-3">
                    <img class="img-fluid ak-radius-lg w-100 ak-ratio-tall" src="/website/static/src/img/snippets_demo/s_images_mosaic_default_image_2.jpg" alt="Ceramic ring vase on marble" loading="lazy"/>
                </div>
                <div class="col-6 col-lg-3">
                    <img class="img-fluid ak-radius-lg w-100 ak-ratio-tall" src="/website/static/src/img/snippets_demo/s_images_mosaic_default_image_3.jpg" alt="Oak desk and wooden chair" loading="lazy"/>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Hero: framed image with overlapping content card -->
<template id="s_ak_hero_framed" name="Akandel Framed Hero">
    <section class="s_ak_hero_framed o_cc o_cc1 pt48 pb80" data-snippet="s_ak_hero_framed" data-name="Framed Hero">
        <div class="container">
            <div class="ak-framed">
                <img class="img-fluid w-100 ak-framed-img" src="/website/static/src/img/library/shop_generic_3_lg.webp" alt="Sunlit terracotta room with a minimal table" loading="eager"/>
                <div class="ak-framed-card o_cc o_cc1">
                    <p class="ak-eyebrow">Studio collection</p>
                    <h2 class="display-5 mb-3">Warm minimalism for modern homes.</h2>
                    <p class="mb-4">Clean lines, warm woods and tactile finishes — the essentials, beautifully considered.</p>
                    <a href="/shop" class="btn btn-primary">Explore pieces</a>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
