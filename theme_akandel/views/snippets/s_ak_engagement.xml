<!-- Delivery & returns: practical FAQ using native, accessible disclosures -->
<template id="s_ak_delivery_info" name="Akandel Delivery &amp; Returns">
    <section class="s_ak_delivery_info o_cc o_cc1 pt96 pb96" data-snippet="s_ak_delivery_info" data-name="Delivery &amp; Returns">
        <div class="container">
            <div class="row g-5">
                <div class="col-lg-4">
                    <p class="ak-eyebrow">Delivery &amp; returns</p>
                    <h2 class="mb-3">Good to know</h2>
                    <p class="ak-muted mb-4">Everything about getting your order home, and sending it back if it isn't right.</p>
                    <a href="/contactus" class="btn btn-outline-primary">Ask a question</a>
                </div>
                <div class="col-lg-8">
                    <div class="ak-faq">
                        <details class="ak-faq-item" open="open">
                            <summary>How much does delivery cost?</summary>
                            <p>Delivery is free on orders over $150. Below that, standard delivery is $9.95 and large-item white-glove delivery is $49.</p>
                        </details>
                        <details class="ak-faq-item">
                            <summary>When will my order arrive?</summary>
                            <p>In-stock items ship within 2 business days. Made-to-order furniture takes 2–6 weeks; the exact date is shown on each product page.</p>
                        </details>
                        <details class="ak-faq-item">
                            <summary>How do I return an item?</summary>
                            <p>Start a return from your account within 30 days. We collect large items for free and send a prepaid label for parcels.</p>
                        </details>
                        <details class="ak-faq-item">
                            <summary>Do you deliver internationally?</summary>
                            <p>We currently deliver across North America and the EU. Duties are calculated at checkout, so there are no surprises.</p>
                        </details>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
