                <a href="/shop" class="ak-link-arrow">Shop the looks <i class="fa fa-long-arrow-right ms-1" aria-hidden="true"/></a>
            </div>
            <div class="row g-3">
                <div class="col-lg-5">
                    <figure class="ak-look mb-0">
                        <img class="img-fluid w-100 ak-ratio-tall" src="/website/static/src/img/snippets_demo/s_parallax.jpg" alt="Bedroom corner with mirror" loading="lazy"/>
                        <figcaption>The bedroom, slowed down</figcaption>
                    </figure>
                </div>
                <div class="col-lg-7">
                    <div class="row g-3">
                        <div class="col-12">
                            <figure class="ak-look mb-0">
                                <img class="img-fluid w-100 ak-ratio-wide" src="/website/static/src/img/library/shop_generic_3_lg.webp" alt="Terracotta room with a table" loading="lazy"/>
                                <figcaption>Sun-warmed dining</figcaption>
                            </figure>
                        </div>
                        <div class="col-6">
                            <figure class="ak-look mb-0">
                                <img class="img-fluid w-100" src="/website/static/src/img/snippets_demo/s_images_mosaic_default_image_2.jpg" alt="Sculptural ceramic vase" loading="lazy"/>
                                <figcaption>Sculptural ceramics</figcaption>
                            </figure>
                        </div>
                        <div class="col-6">
                            <figure class="ak-look mb-0">
                                <img class="img-fluid w-100" src="/website/static/src/img/snippets_demo/s_images_mosaic_default_image_4.jpg" alt="Vases in a plaster niche" loading="lazy"/>
                                <figcaption>Earthy accents</figcaption>
                            </figure>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Shop the look: large image with product hotspots -->
<template id="s_ak_shop_the_look" name="Akandel Shop the Look">
    <section class="s_ak_shop_the_look o_cc o_cc2 pt80 pb80" data-snippet="s_ak_shop_the_look" data-name="Shop the Look">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <div class="ak-hotspot-stage">
                        <img class="img-fluid w-100 ak-radius-xl" src="/website/static/src/img/library/shop_generic_1_lg.jpg" alt="Living room with sofa, side table and cushions" loading="lazy"/>
                        <a href="/shop" class="ak-hotspot" style="top: 52%; left: 46%;" aria-label="Loma sofa"><span class="ak-hotspot-label">Loma sofa · $1,890</span></a>
                        <a href="/shop" class="ak-hotspot" style="top: 49%; left: 16%;" aria-label="Pine side table"><span class="ak-hotspot-label">Pine side table · $240</span></a>
                        <a href="/shop" class="ak-hotspot" style="top: 80%; left: 82%;" aria-label="Velvet cushion"><span class="ak-hotspot-label">Velvet cushion · $45</span></a>
                    </div>
