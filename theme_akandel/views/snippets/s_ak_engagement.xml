            <div class="row g-4">
                <div class="col-md-4">
                    <article class="ak-article">
                        <a href="#" class="d-block mb-3"><img class="img-fluid w-100 ak-radius-lg ak-ratio-photo" src="/website/static/src/img/snippets_demo/s_images_mosaic_default_image_5.jpg" alt="Curved plaster staircase" loading="lazy"/></a>
