<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ======================= Testimonials ======================= -->

<!-- Reviews grid: three customer review cards -->
<template id="s_ak_testimonials_grid" name="Akandel Reviews Grid">
    <section class="s_ak_testimonials_grid o_cc o_cc2 pt96 pb96" data-snippet="s_ak_testimonials_grid" data-name="Reviews Grid">
        <div class="container">
            <div class="ak-section-head d-flex flex-wrap align-items-end justify-content-between gap-3 mb-5">
                <div>
                    <p class="ak-eyebrow">Reviews</p>
                    <h2 class="mb-0">Loved in 18,000 homes</h2>
                </div>
                <p class="ak-rating mb-0" aria-label="Average rating 4.9 out of 5">
                    <i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/>
                    <span class="ms-2"><strong>4.9</strong> average from 2,300+ reviews</span>
                </p>
            </div>
            <div class="row g-4">
                <div class="col-lg-4">
                    <figure class="ak-review h-100 mb-0">
                        <p class="ak-rating small mb-3" aria-label="5 out of 5"><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/></p>
                        <blockquote class="mb-4"><p class="mb-0">“The sofa is even more beautiful in person. Delivery was on time and they took all the packaging away.”</p></blockquote>
                        <figcaption class="d-flex align-items-center gap-3">
                            <span class="ak-avatar" aria-hidden="true">MR</span>
                            <span><strong class="d-block">Maya R.</strong><span class="small ak-muted">Loma sofa · Verified buyer</span></span>
                        </figcaption>
                    </figure>
                </div>
                <div class="col-lg-4">
                    <figure class="ak-review h-100 mb-0">
                        <p class="ak-rating small mb-3" aria-label="5 out of 5"><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/></p>
                        <blockquote class="mb-4"><p class="mb-0">“Solid, heavy, gorgeous oak. You can feel the craftsmanship. Our dining room finally feels finished.”</p></blockquote>
                        <figcaption class="d-flex align-items-center gap-3">
                            <span class="ak-avatar" aria-hidden="true">JT</span>
                            <span><strong class="d-block">James T.</strong><span class="small ak-muted">Arlo table · Verified buyer</span></span>
                        </figcaption>
                    </figure>
                </div>
                <div class="col-lg-4">
                    <figure class="ak-review h-100 mb-0">
                        <p class="ak-rating small mb-3" aria-label="4 out of 5"><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star" aria-hidden="true"/><i class="fa fa-star-o" aria-hidden="true"/></p>
                        <blockquote class="mb-4"><p class="mb-0">“Lovely lamp with a warm, soft glow. Customer service helped me pick the right bulb.”</p></blockquote>
                        <figcaption class="d-flex align-items-center gap-3">
                            <span class="ak-avatar" aria-hidden="true">SK</span>
                            <span><strong class="d-block">Sofia K.</strong><span class="small ak-muted">Tilde lamp · Verified buyer</span></span>
                        </figcaption>
                    </figure>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Feature testimonial: one large quote with portrait image -->
<template id="s_ak_testimonial_feature" name="Akandel Feature Testimonial">
    <section class="s_ak_testimonial_feature o_cc o_cc5 pt96 pb96" data-snippet="s_ak_testimonial_feature" data-name="Feature Testimonial">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <i class="fa fa-quote-left ak-quote-mark" aria-hidden="true"/>
                    <blockquote class="ak-quote-lg mb-4"><p class="mb-0">“Akandel pieces bring a calm to the home that is hard to describe. You notice the care in every joint and seam.”</p></blockquote>
                    <p class="mb-0"><strong>Elena Moreau</strong> · <span class="ak-muted">Interior architect, Lyon</span></p>
                </div>
                <div class="col-lg-4 offset-lg-1">
                    <img class="img-fluid w-100 ak-radius-xl ak-ratio-tall" src="/website/static/src/img/snippets_demo/s_parallax.jpg" alt="Calm bedroom styled with Akandel pieces" loading="lazy"/>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- ======================= Newsletter ======================= -->

<!-- Newsletter band: centered signup (real website_mass_mailing form) -->
<template id="s_ak_newsletter_band" name="Akandel Newsletter Band">
    <section class="s_ak_newsletter_band o_cc o_cc4 pt80 pb80" data-snippet="s_ak_newsletter_band" data-name="Newsletter Band">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-7">
                    <p class="ak-eyebrow">The Akandel letter</p>
                    <h2 class="display-6 mb-3">Get 10% off your first order</h2>
                    <p class="mb-4">Join 40,000 subscribers for new arrivals, styling ideas and members-only offers.</p>
                    <t t-call="theme_akandel.ak_snippet_newsletter_form" _ak_btn_class.f="btn-dark"/>
                    <p class="small mt-3 mb-0 ak-muted">You can unsubscribe at any time. See our <a href="/privacy">privacy policy</a>.</p>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Newsletter split: image + signup -->
<template id="s_ak_newsletter_split" name="Akandel Newsletter Split">
    <section class="s_ak_newsletter_split o_cc o_cc2 pt0 pb0" data-snippet="s_ak_newsletter_split" data-name="Newsletter Split">
        <div class="container-fluid px-0">
            <div class="row g-0 align-items-stretch">
                <div class="col-lg-6">
                    <img class="img-fluid w-100 h-100 ak-cover-img" src="/website/static/src/img/snippets_demo/s_images_mosaic_default_image_1.jpg" alt="Dining table with fresh flowers" loading="lazy"/>
                </div>
                <div class="col-lg-6 d-flex align-items-center">
                    <div class="ak-newsletter-panel">
                        <p class="ak-eyebrow">Stay inspired</p>
                        <h2 class="mb-3">Ideas for a home you love</h2>
                        <p class="mb-4 ak-muted">Seasonal edits, care guides and first access to limited runs — once a week, never more.</p>
                        <t t-call="theme_akandel.ak_snippet_newsletter_form"/>
                    </div>
                </div>
            </div>
        </div>
    </section>
</template>

<!-- Real newsletter form for snippets: the list is assigned on drop by the
     website_mass_mailing builder option (and at homepage seeding time). -->
<template id="ak_snippet_newsletter_form" name="Akandel Snippet Newsletter Form">
    <t t-set="ak_mailing_list" t-value="res_company.env.ref('mass_mailing.mailing_list_data', raise_if_not_found=False)"/>
    <div class="s_newsletter_subscribe_form s_newsletter_list js_subscribe ak-newsletter-form" data-vxml="001"
         t-att-data-list-id="ak_mailing_list.id if ak_mailing_list else 0" data-name="Newsletter Form">
        <div class="js_subscribed_wrap d-none">
            <p class="ak-newsletter-success mb-0"><i class="fa fa-check-circle-o me-1" role="img" aria-hidden="true"/>Thanks for subscribing! Check your inbox.</p>
        </div>
        <div class="js_subscribe_wrap">
            <div class="input-group input-group-lg">
                <input type="email" name="email" class="js_subscribe_value form-control" placeholder="Your email address" aria-label="Email address"/>
                <a role="button" href="#" t-attf-class="js_subscribe_btn o_submit btn #{_ak_btn_class or 'btn-primary'}">Subscribe</a>
            </div>
        </div>
    </div>
</template>

<!-- ======================= Editorial ======================= -->

<!-- Lookbook mosaic: images with captions -->
<template id="s_ak_lookbook" name="Akandel Lookbook">
    <section class="s_ak_lookbook o_cc o_cc1 pt96 pb96" data-snippet="s_ak_lookbook" data-name="Lookbook">
        <div class="container">
