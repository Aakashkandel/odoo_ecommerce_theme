<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="payment_method_connectips" model="payment.method">
        <field name="name">connectIPS</field>
        <field name="code">connectips</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field
            name="image"
            type="base64"
            file="payment_connectips/static/description/icon.png"
        />
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
        <field name="supported_country_ids" eval="[Command.set([ref('base.np')])]" />
        <field name="supported_currency_ids" eval="[Command.set([ref('base.NPR')])]" />
    </record>

</odoo>
