<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="redirect_form">
        <form t-att-action="api_url" method="post">
            <t t-foreach="form_values" t-as="field_name">
                <input
                    type="hidden"
                    t-att-name="field_name"
                    t-att-value="field_name_value"
                />
            </t>
        </form>
    </template>

</odoo>
