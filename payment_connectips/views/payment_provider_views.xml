<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">connectIPS Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'connectips'">
                    <field
                        name="connectips_merchant_id"
                        string="Merchant ID"
                        required="code == 'connectips' and state != 'disabled'"
                    />
                    <field
                        name="connectips_app_id"
                        string="App ID"
                        required="code == 'connectips' and state != 'disabled'"
                    />
                    <field
                        name="connectips_app_name"
                        string="App Name"
                        required="code == 'connectips' and state != 'disabled'"
                    />
                    <field
                        name="connectips_app_password"
                        string="API Password"
                        required="code == 'connectips' and state != 'disabled'"
                        password="True"
                    />
                    <field
                        name="connectips_certificate"
                        string="Certificate (PFX)"
                        required="code == 'connectips' and state != 'disabled'"
                    />
                    <field
                        name="connectips_certificate_password"
                        string="Certificate Password"
                        password="True"
                    />
                    <field
                        name="connectips_test_base_url"
                        string="Test Base URL"
                        placeholder="https://..."
                        required="code == 'connectips' and state == 'test'"
                    />
                    <field
                        name="connectips_production_base_url"
                        string="Production Base URL"
                        placeholder="https://..."
                        required="code == 'connectips' and state == 'enabled'"
                    />
                </group>
            </group>
        </field>
    </record>

</odoo>
